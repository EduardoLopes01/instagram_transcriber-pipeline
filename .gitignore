# Virtual Environment
venv/
.venv/
env/

# Configurações sensíveis (API Keys)
.env
.env*.local

# Cache do Python
__pycache__/
*.py[cod]
*$py.class

# Diretórios temporários de mídia e texto
downloads/*
!downloads/.gitkeep
transcripts/*
